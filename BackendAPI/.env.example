# BackendAPI environment variables
# Database connection string (async SQLAlchemy, asyncpg driver)
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
POSTGRES_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# JWT configuration
JWT_SECRET_KEY=replace-with-secure-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS allowed origins (comma-separated). Example: http://localhost:3000,https://myapp.com
CORS_ORIGINS=http://localhost:3000

# Frontend variables (read for CORS fallback)
REACT_APP_API_BASE=http://localhost:8000
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_FRONTEND_URL=http://localhost:3000
REACT_APP_WS_URL=
REACT_APP_NODE_ENV=development
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=1
REACT_APP_PORT=8000
REACT_APP_TRUST_PROXY=1
REACT_APP_LOG_LEVEL=INFO
REACT_APP_HEALTHCHECK_PATH=/
REACT_APP_FEATURE_FLAGS=
REACT_APP_EXPERIMENTS_ENABLED=
